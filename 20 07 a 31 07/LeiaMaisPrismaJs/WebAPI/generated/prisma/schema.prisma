// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Autor {
  id             Int      @id @default(autoincrement())
  nome           String
  nacionalidade  String
  dataNascimento DateTime
  livros         Livro[]
}

model Editora {
  id           Int       @id @default(autoincrement())
  nome         String    @unique
  cidade       String
  dataFundacao DateTime
  pais         String
  livros       Livro[]
  deletedAt    DateTime?
}

model Livro {
  id             Int         @id @default(autoincrement())
  nome           String      @unique
  isbn           String
  dataFundacao   DateTime
  numPaginas     Int
  volume         Int
  colecao        String      @db.VarChar(50)
  edicao         String      @db.VarChar(50)
  dataLancamento DateTime
  idGenero       Int
  genero         GeneroLivro @relation(fields: [idGenero], references: [id])
  idEditora      Int
  editora        Editora     @relation(fields: [idEditora], references: [id])
  idAutor        Int
  autor          Autor       @relation(fields: [idAutor], references: [id])
}

model GeneroLivro {
  id     Int     @id @default(autoincrement())
  nome   String
  livros Livro[]
}
